<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <rect width="800" height="600" fill="#f3f8e9"/>
  <g transform="translate(400,300)">
    <g>
      <!-- Tea cup -->
      <path d="M-100,50 C-100,0 100,0 100,50 L80,150 C80,180 -80,180 -80,150 Z" fill="#fff" stroke="#4b7f52" stroke-width="8"/>
      <!-- Steam -->
      <path d="M-30,-10 C-40,-30 -20,-50 -10,-40 C0,-60 20,-60 10,-40 C30,-60 40,-30 20,-10" fill="none" stroke="#4b7f52" stroke-width="4" stroke-linecap="round"/>
      <!-- Tea leaves -->
      <ellipse cx="-40" cy="80" rx="15" ry="8" fill="#4b7f52" transform="rotate(-20)"/>
      <ellipse cx="20" cy="90" rx="18" ry="7" fill="#4b7f52" transform="rotate(15)"/>
      <ellipse cx="-10" cy="110" rx="12" ry="6" fill="#4b7f52" transform="rotate(-10)"/>
    </g>
    <text x="0" y="-100" font-family="Arial" font-size="48" text-anchor="middle" fill="#4b7f52" font-weight="bold">Our Mission</text>
    <text x="0" y="-50" font-family="Arial" font-size="24" text-anchor="middle" fill="#666">Bringing Nature's Goodness to Your Cup</text>
  </g>
</svg>